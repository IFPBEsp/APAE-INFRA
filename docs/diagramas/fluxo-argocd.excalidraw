      "boundElements": [],
      "updated": 1787764782991,
      "link": null,
      "locked": false,
      "text": "Repositório\ncentralizado\nque guarda a\ninfraestrutura\ndeclarativa e\nas definições\nde applications\ndo ArgoCD.\nAPAE-INFRA",
      "fontSize": 30.642850660647877,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-CgqG6y5vnKV3ymxKgdPb",
      "originalText": "Repositório centralizado que guarda a infraestrutura declarativa e as definições de applications do ArgoCD.\nAPAE-INFRA",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AMeAZk2wubWg_jNnvCCfR",
      "type": "text",
      "x": 158.80930480458073,
      "y": -357.975018556991,
      "width": 261.7734794092283,
      "height": 81.04307401340824,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1590392904,
      "version": 1285,
      "versionNonce": 341904200,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787764782985,
      "link": null,
      "locked": false,
      "text": "PR é criado para que tenha uma\naprovação manual antes do merge\natualizando a tag da imagem no \nreposirtório APAE-INFRA",
      "fontSize": 16.208614802681648,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PR é criado para que tenha uma\naprovação manual antes do merge\natualizando a tag da imagem no \nreposirtório APAE-INFRA",
      "autoResize": true,
      "lineHeight": 1.25
    },
