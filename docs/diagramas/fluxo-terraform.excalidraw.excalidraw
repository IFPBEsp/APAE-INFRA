      "text": "/terraform/modules/\n├── kubernetes-cluster/   → provisiona o OKE\n├── network/              → VPC, subnets\n├── compute/              → VMs\n└── object-storage/       → bucket para o state",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/terraform/modules/\n├── kubernetes-cluster/   → provisiona o OKE\n├── network/              → VPC, subnets\n├── compute/              → VMs\n└── object-storage/       → bucket para o state",
      "autoResize": true,
      "lineHeight": 1.25,
