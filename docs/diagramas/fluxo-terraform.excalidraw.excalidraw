      "text": "/terraform/environments/\n├── dev/    → chama os módulos com config menor\n├── hml/    → chama os módulos com config média  \n└── prod/   → chama os módulos com config completa",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/terraform/environments/\n├── dev/    → chama os módulos com config menor\n├── hml/    → chama os módulos com config média  \n└── prod/   → chama os módulos com config completa",
      "autoResize": true,
